// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  TEACHER
  STUDENT
  PARENT
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         Role
  classId      String?
  class        Class?   @relation("ClassStudents", fields: [classId], references: [id])
  parentId     String?
  parent       User?    @relation("ParentChild", fields: [parentId], references: [id])
  children     User[]   @relation("ParentChild")
  createdAt    DateTime @default(now())

  sessions           Session[]
  teachingClasses    Class[]           @relation("ClassTeacher")
  coursesCreated     Course[]
  lessonsCreated     Lesson[]
  enrollments        Enrollment[]
  studySessions      StudySession[]    @relation("StudySessionStudent")
  focusEvents        FocusEvent[]      @relation("FocusEventStudent")
  ackedEvents        FocusEvent[]      @relation("FocusEventAck")
  checkpointAttempts CheckpointAttempt[]
  settingsEdited     FocusSettings?
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  createdAt DateTime @default(now())
  expiresAt DateTime

  @@index([token])
}

model Class {
  id        String   @id @default(cuid())
  name      String
  courseId  String?
  course    Course?  @relation(fields: [courseId], references: [id])
  teacherId String?
  teacher   User?    @relation("ClassTeacher", fields: [teacherId], references: [id])
  students  User[]   @relation("ClassStudents")
  createdAt DateTime @default(now())
}

model Course {
  id          String       @id @default(cuid())
  title       String
  description String?
  authorId    String
  author      User         @relation(fields: [authorId], references: [id])
  lessons     Lesson[]
  classes     Class[]
  enrollments Enrollment[]
  createdAt   DateTime     @default(now())
}

model Lesson {
  id              String            @id @default(cuid())
  courseId        String
  course          Course            @relation(fields: [courseId], references: [id], onDelete: Cascade)
  order           Int
  title           String
  videoUrl        String
  durationSeconds Int?
  notesHtml       String?
  gated           Boolean           @default(true)
  authorId        String
  author          User              @relation(fields: [authorId], references: [id])
  checkpoints     LessonCheckpoint[]
  sessions        StudySession[]
  createdAt       DateTime          @default(now())

  @@unique([courseId, order])
}

model LessonCheckpoint {
  id           String             @id @default(cuid())
  lessonId     String
  lesson       Lesson             @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  order        Int
  timeSeconds  Float
  prompt       String
  options      String
  correctIndex Int
  requiresPass Boolean            @default(true)
  attempts     CheckpointAttempt[]
}

model Enrollment {
  id         String   @id @default(cuid())
  studentId  String
  student    User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  courseId   String
  course     Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  enrolledAt DateTime @default(now())

  @@unique([studentId, courseId])
}

model StudySession {
  id                 String       @id @default(cuid())
  studentId          String
  student            User         @relation("StudySessionStudent", fields: [studentId], references: [id], onDelete: Cascade)
  lessonId           String
  lesson             Lesson       @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  startedAt          DateTime     @default(now())
  endedAt            DateTime?
  lastActiveAt       DateTime     @default(now())
  totalActiveSeconds Int          @default(0)
  watchedSeconds     Float        @default(0)
  maxPlayhead        Float        @default(0)
  reflection         String?
  status             String       @default("ACTIVE")
  focusEvents        FocusEvent[]

  @@index([studentId, lessonId])
}

model FocusEvent {
  id               String       @id @default(cuid())
  sessionId        String
  session          StudySession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  studentId        String
  student          User         @relation("FocusEventStudent", fields: [studentId], references: [id], onDelete: Cascade)
  type             String
  severity         String
  reason           String
  detail           String?
  occurredAt       DateTime     @default(now())
  ackStatus        String       @default("PENDING")
  ackNote          String?
  acknowledgedById String?
  acknowledgedBy   User?        @relation("FocusEventAck", fields: [acknowledgedById], references: [id])

  @@index([studentId, occurredAt])
  @@index([ackStatus])
}

model CheckpointAttempt {
  id           String          @id @default(cuid())
  studentId    String
  student      User            @relation(fields: [studentId], references: [id], onDelete: Cascade)
  checkpointId String
  checkpoint   LessonCheckpoint @relation(fields: [checkpointId], references: [id], onDelete: Cascade)
  correct      Boolean
  submittedAt  DateTime        @default(now())
}

model FocusSettings {
  id                      Int     @id @default(1)
  heartbeatTimeoutSeconds Int     @default(45)
  hiddenRedSeconds        Int     @default(30)
  pausedYellowSeconds     Int     @default(30)
  idleYellowSeconds       Int     @default(60)
  fullscreenYellowSeconds Int     @default(15)
  repeatedSwitchCount     Int     @default(3)
  nudgeCooldownSeconds    Int     @default(60)
  updatedById             String?  @unique
  updatedBy               User?    @relation(fields: [updatedById], references: [id])
}

model ContactSubmission {
  id        String   @id @default(cuid())
  name      String
  phone     String
  email     String
  interest  String?
  message   String
  createdAt DateTime @default(now())
}
